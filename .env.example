PORT=3001
# Genera cada uno con: openssl rand -hex 32  (o: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# CHAT_JWT_SECRET debe ser IGUAL en Facilapr (firma los tokens que este servidor verifica).
CHAT_JWT_SECRET=
# CHAT_EMIT_SECRET debe ser IGUAL en Facilapr (autoriza a Facilapr a publicar mensajes).
CHAT_EMIT_SECRET=
# Dominios desde los que se aceptan conexiones, separados por coma. "*" vale como subdominio (el portal de cada comité).
CORS_ORIGINS=https://facilapr.cl,https://www.facilapr.cl,https://*.facilapr.cl
